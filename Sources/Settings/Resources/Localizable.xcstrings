    "Bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar"
          }
        }
      }
    },
    "Bar replaces the system Dock, hidden with Finder's icon, whose settings come back with the System Dock. Shown while Explorer manages files (General).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar remplace le Dock système, masqué avec l'icône du Finder, dont les réglages reviennent avec le Dock système. Affiché quand Explorer gère les fichiers (Général)."
          }
        }
      }
    },
    "Minimize windows into application icon": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer les fenêtres dans l’icône de l’app"
          }
        }
      }
    },
    "Animate opening applications": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animer l’ouverture des applications"
          }
