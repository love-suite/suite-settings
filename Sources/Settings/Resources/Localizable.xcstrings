          }
        }
      }
    },
    "Open Clipboard at login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Clipboard à la connexion"
          }
        }
      }
    },
    "Turn Clipboard on in System Settings › General › Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Clipboard dans Réglages Système › Général › Ouverture automatique."
          }
        }
      }
