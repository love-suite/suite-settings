            "state": "translated",
            "value": "Serveurs connectés"
          }
        }
      }
    },
    "Open folders and stacks when dragging onto them": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les dossiers et les piles en y faisant glisser des éléments"
          }
        }
      }
    },
    "Spring-loading is off in System Settings › Accessibility › Pointer Control.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouverture automatique est désactivée dans Réglages Système › Accessibilité › Contrôle du pointeur."
          }
        }
      }
    },
    "After %@ s, the delay set in System Settings › Accessibility › Pointer Control.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %@ s, le délai réglé dans Réglages Système › Accessibilité › Contrôle du pointeur."
          }
        }
      }
    },
