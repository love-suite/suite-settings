    "Work, Home, Presentation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail, Maison, Présentation"
          }
        }
      }
    },
    "Your settings aren’t saved in a profile yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages ne sont pas encore enregistrés dans un profil."
          }
        }
      }
    },
    "iCloud Drive": {},
    "saved ": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "enregistré le "
          }
        }
      }
    },
    "“Show All” at the end of the list opens the whole history in a window. The pin at the top of the list keeps it open when you click elsewhere or paste.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Tout afficher » en bas de la liste ouvre tout l'historique dans une fenêtre. L'épingle en haut de la liste la garde ouverte quand vous cliquez ailleurs ou collez."
          }
        }
      }
    },
